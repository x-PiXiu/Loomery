  <diagram name="P2-主窗口·Codex布局" id="page-codex">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="920">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c0" value="Loomery 主窗口（Codex 预设 · 默认）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=6" vertex="1" parent="1"><mxGeometry x="60" y="40" width="1300" height="800" as="geometry"/></mxCell>
        <mxCell id="c1" value="活&#10;动&#10;栏" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=15" vertex="1" parent="1"><mxGeometry x="80" y="90" width="44" height="640" as="geometry"/></mxCell>
        <mxCell id="c2" value="侧栏：会话列表 Threads&#10;· 时间分组（今天/昨天）&#10;· 自动标题 + 摘要&#10;· 搜索&#10;· ＋新建 / ⟳&#10;· busy 会话 ⏳ 标记" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="136" y="90" width="250" height="640" as="geometry"/></mxCell>
        <mxCell id="c3" value="编辑器（默认折叠为窄条）&#10;点 diff 卡 / 文件引用时展开&#10;&#10;· 文件树&#10;· 标签页&#10;· Monaco&#10;· DiffPane" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=10;verticalAlign=top;spacingTop=8;dashed=1" vertex="1" parent="1"><mxGeometry x="396" y="90" width="190" height="640" as="geometry"/></mxCell>
        <mxCell id="c4" value="Chat 面板（主舞台，占最大面积）&#10;· 消息流：用户气泡 / 流式回复&#10;· 工具卡（可折叠，状态自描述）&#10;· 审批卡：内联 diff + 接受/拒绝&#10;· Turn 页脚：token/费用/耗时/终止原因&#10;· Checkpoint 横幅：回滚入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=12;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="598" y="90" width="742" height="520" as="geometry"/></mxCell>
        <mxCell id="c5" value="Composer&#10;[计划|编辑|解释] 分段模式 · @文件引用 · 模型选择&#10;输入区（Enter 发送 / Shift+Enter 换行）&#10;运行中变「停止」按钮" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=12;verticalAlign=top;spacingTop=6" vertex="1" parent="1"><mxGeometry x="598" y="620" width="742" height="110" as="geometry"/></mxCell>
        <mxCell id="c6" value="状态栏：阶段 · 模式 · 模型 · token/预算 · 挂起审批数 · ↩ 回滚 · 事件时间线入口" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;align=left;spacingLeft=10" vertex="1" parent="1"><mxGeometry x="80" y="742" width="1260" height="36" as="geometry"/></mxCell>
        <mxCell id="c7" value="布局要点&#10;1. Chat 是视觉中心（60% 宽），编辑器折叠——对话优先&#10;2. 侧栏只放会话（Codex 语义），文件树收进编辑器面板&#10;3. 双击 Chat 标签 = 对话聚焦模式（独占主区）&#10;4. 审批卡出现在消息流内，不弹独立对话框&#10;5. 拖拽后按预设持久化，重启还原" style="text;html=1;fontSize=15;align=left;verticalAlign=top;spacingTop=4" vertex="1" parent="1"><mxGeometry x="80" y="620" width="500" height="110" as="geometry"/></mxCell>
        <mxCell id="c8" value="图例：蓝=活动栏  绿=工作面板  黄=交互区  灰=状态栏" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="80" y="788" width="600" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="P3-对话面板细节" id="page-chat">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="900" pageHeight="1120">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t0" value="消息流（自上而下，仅含已发生的事件）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=15;fontStyle=1;verticalAlign=top;spacingTop=4" vertex="1" parent="1"><mxGeometry x="40" y="40" width="560" height="920" as="geometry"/></mxCell>
        <mxCell id="t1" value="用户气泡：帮我改 config.ts 的超时时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="220" y="80" width="360" height="44" as="geometry"/></mxCell>
        <mxCell id="t2" value="助手流式回复 ▌（textDelta 节流合并渲染）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=15;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="60" y="136" width="380" height="44" as="geometry"/></mxCell>
        <mxCell id="t3" value="工具卡 🛠 read_file  ✓ 完成 · 12ms&#10;预览（默认折叠，失败/待审批自动展开）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" vertex="1" parent="1"><mxGeometry x="60" y="192" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="t4" value="工具卡 🛠 apply_diff  ⏳ 待审批" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="60" y="264" width="520" height="36" as="geometry"/></mxCell>
        <mxCell id="t5" value="审批卡（内联，不弹窗）&#10;diff 预览：@@ -12,3 +12,4 @@&#10;-timeout: 3000&#10;+timeout: 10000&#10;[接受 Ctrl+Enter]  [拒绝 Esc]&#10;拒绝可附原因 → 回灌给模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="1"><mxGeometry x="60" y="312" width="520" height="140" as="geometry"/></mxCell>
        <mxCell id="t6" value="工具卡 🛠 write_file  ✓ 完成 · 8ms" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="60" y="464" width="520" height="36" as="geometry"/></mxCell>
        <mxCell id="t7" value="Checkpoint 横幅：本轮已修改 1 个文件 · [↩ 回滚]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=15;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="60" y="512" width="520" height="36" as="geometry"/></mxCell>
        <mxCell id="t8" value="助手回复：已把超时改为 10s。&#10;Turn 页脚：tokens 1,240 · 步数 3 · 8.2s · 自然终止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=15;align=left;spacingLeft=8;verticalAlign=top;spacingTop=4" vertex="1" parent="1"><mxGeometry x="60" y="560" width="520" height="60" as="geometry"/></mxCell>
        <mxCell id="t9" value="notice 行：已停止（maxSteps）：已读文件并提交修改，等待审批时预算耗尽…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;align=left;spacingLeft=8;dashed=1" vertex="1" parent="1"><mxGeometry x="60" y="632" width="520" height="36" as="geometry"/></mxCell>
        <mxCell id="t10" value="设计说明&#10;1. 审批卡是“审批门”的可视形态——出现即阻塞循环，状态自动展开&#10;2. 工具卡状态机：pending→审批/运行→完成/失败，全部由事件驱动&#10;3. diff 预览仅展示 hunk；点“查看完整 diff”跳编辑器 DiffPane&#10;4. 每条 notice 对应一条事件（重试/错误/终止原因），可追责" style="text;html=1;fontSize=15;align=left;verticalAlign=top;spacingTop=4" vertex="1" parent="1"><mxGeometry x="620" y="80" width="250" height="360" as="geometry"/></mxCell>
        <mxCell id="t11" value="Composer&#10;[计划|编辑|解释]　模型：deepseek-chat ▾　@引用文件&#10;┌────────────────────────┐&#10;│ 输入区…                     │&#10;└────────────────────────┘&#10;编辑模式　　　　　　　　[发送]" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6" vertex="1" parent="1"><mxGeometry x="40" y="976" width="560" height="120" as="geometry"/></mxCell>
        <mxCell id="t12" value="运行中：发送按钮变「停止」→ 取消传播链（模型流/工具/消息收尾）" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="620" y="1000" width="250" height="70" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="P4-编辑器区细节" id="page-editor">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="880">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="e0" value="编辑器面板" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontStyle=1;verticalAlign=top;spacingTop=4" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1120" height="720" as="geometry"/></mxCell>
        <mxCell id="e1" value="文件树&#10;（懒加载目录）&#10;· 📁 packages/&#10;· 📄 package.json&#10;· 📄 README.md&#10;· 过滤 node_modules&#10;点击打开文件" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="60" y="84" width="220" height="656" as="geometry"/></mxCell>
        <mxCell id="e2" value="标签页：config.ts ● ｜ main.ts   （● = 未保存，Ctrl+S 保存）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15;align=left;spacingLeft=8" vertex="1" parent="1"><mxGeometry x="292" y="84" width="848" height="36" as="geometry"/></mxCell>
        <mxCell id="e3" value="Monaco 编辑器（只读模式跟随会话模式）&#10;Agent 改盘后：无脏改动静默刷新；有脏改动提示（并发编辑显性化）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontSize=15;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8" vertex="1" parent="1"><mxGeometry x="292" y="132" width="848" height="400" as="geometry"/></mxCell>
        <mxCell id="e4" value="DiffPane（Monaco DiffEditor，查看 Agent 提议的修改时打开）&#10;左侧：当前文件 ｜ 右侧：修改后&#10;inline / side-by-side 可切换" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=15;align=left;spacingLeft=8;verticalAlign=top;spacingTop=8;dashed=1" vertex="1" parent="1"><mxGeometry x="292" y="544" width="848" height="196" as="geometry"/></mxCell>
        <mxCell id="e5" value="设计说明&#10;1. DiffPane 以编辑器标签页打开（不是浮层），可并排对照 Chat&#10;2. 文件树只读展示；P1 不做树内右键菜单&#10;3. Agent/用户并发编辑：脏文件只提示不覆盖&#10;4. 诊断来自 Monaco worker（P3 换 LSP），同时喂给上下文 Provider" style="text;html=1;fontSize=15;align=left;verticalAlign=top;spacingTop=4" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1120" height="80" as="geometry"/></mxCell>
        <mxCell id="el1" value="图例：绿=文件树  黄=标签页  白=编辑器  橙=Diff 视图" style="text;html=1;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="292" y="752" width="500" height="26" as="geometry"/></mxCell>
      </root>
