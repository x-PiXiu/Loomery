        <mxCell id="k4" value="状态栏&#10;阶段/模式/token/回滚" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=15" vertex="1" parent="1"><mxGeometry x="1210" y="150" width="170" height="64" as="geometry"/></mxCell>
        <mxCell id="k5" value="模式A：任务列表&#10;新建/插件市场/项目分组任务" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=15" vertex="1" parent="1"><mxGeometry x="60" y="300" width="240" height="60" as="geometry"/></mxCell>
